<mujoco model="g1 stairs">
  <!-- Stairs rung scene: flat approach (spawn x~0) -> 5 steps
       (rise 0.09, run 0.28, base x=1.5) -> top landing (top z=0.45).
       Includes resolve from the playground asset dict (see G1Env). -->
  <include file="g1_mjx_feetonly.xml"/>

  <statistic center="2 0 0.7" extent="2.5" meansize="0.04"/>

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="140" elevation="-20"/>
    <map force="0.01"/>
    <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1"
      markrgb="0 0 0" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
    <material name="step" rgba="0.45 0.47 0.5 1"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.01" type="plane" material="groundplane"/>
    <geom name="step1" type="box" size="0.14 1.0 0.045" pos="1.64 0 0.045" material="step" contype="1" conaffinity="1"/>
    <geom name="step2" type="box" size="0.14 1.0 0.09" pos="1.92 0 0.09" material="step" contype="1" conaffinity="1"/>
    <geom name="step3" type="box" size="0.14 1.0 0.135" pos="2.20 0 0.135" material="step" contype="1" conaffinity="1"/>
    <geom name="step4" type="box" size="0.14 1.0 0.18" pos="2.48 0 0.18" material="step" contype="1" conaffinity="1"/>
    <geom name="step5" type="box" size="0.14 1.0 0.225" pos="2.76 0 0.225" material="step" contype="1" conaffinity="1"/>
    <geom name="landing" type="box" size="1.0 1.0 0.225" pos="3.9 0 0.225" material="step" contype="1" conaffinity="1"/>
  </worldbody>

  <!-- G1 feetonly sets robot geoms conaffinity=0: they collide ONLY with
       geoms named in explicit <pair>s (floor today). Without these pairs
       the robot walks through the steps on the infinite floor plane.
       All 8 robot collision geoms x 6 step boxes = 48 pairs. (Torso has
       no collision geom in feetonly — same as floor behavior today.) -->
  <contact>
    <pair geom1="left_foot" geom2="step1" condim="3" friction="0.6 0.6"/>
    <pair geom1="left_foot" geom2="step2" condim="3" friction="0.6 0.6"/>
    <pair geom1="left_foot" geom2="step3" condim="3" friction="0.6 0.6"/>
    <pair geom1="left_foot" geom2="step4" condim="3" friction="0.6 0.6"/>
    <pair geom1="left_foot" geom2="step5" condim="3" friction="0.6 0.6"/>
    <pair geom1="left_foot" geom2="landing" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_foot" geom2="step1" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_foot" geom2="step2" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_foot" geom2="step3" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_foot" geom2="step4" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_foot" geom2="step5" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_foot" geom2="landing" condim="3" friction="0.6 0.6"/>
    <pair geom1="left_thigh" geom2="step1" condim="3" friction="0.6 0.6"/>
    <pair geom1="left_thigh" geom2="step2" condim="3" friction="0.6 0.6"/>
    <pair geom1="left_thigh" geom2="step3" condim="3" friction="0.6 0.6"/>
    <pair geom1="left_thigh" geom2="step4" condim="3" friction="0.6 0.6"/>
    <pair geom1="left_thigh" geom2="step5" condim="3" friction="0.6 0.6"/>
    <pair geom1="left_thigh" geom2="landing" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_thigh" geom2="step1" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_thigh" geom2="step2" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_thigh" geom2="step3" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_thigh" geom2="step4" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_thigh" geom2="step5" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_thigh" geom2="landing" condim="3" friction="0.6 0.6"/>
    <pair geom1="left_shin" geom2="step1" condim="3" friction="0.6 0.6"/>
    <pair geom1="left_shin" geom2="step2" condim="3" friction="0.6 0.6"/>
    <pair geom1="left_shin" geom2="step3" condim="3" friction="0.6 0.6"/>
    <pair geom1="left_shin" geom2="step4" condim="3" friction="0.6 0.6"/>
    <pair geom1="left_shin" geom2="step5" condim="3" friction="0.6 0.6"/>
    <pair geom1="left_shin" geom2="landing" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_shin" geom2="step1" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_shin" geom2="step2" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_shin" geom2="step3" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_shin" geom2="step4" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_shin" geom2="step5" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_shin" geom2="landing" condim="3" friction="0.6 0.6"/>
    <pair geom1="left_hand_collision" geom2="step1" condim="3" friction="0.6 0.6"/>
    <pair geom1="left_hand_collision" geom2="step2" condim="3" friction="0.6 0.6"/>
    <pair geom1="left_hand_collision" geom2="step3" condim="3" friction="0.6 0.6"/>
    <pair geom1="left_hand_collision" geom2="step4" condim="3" friction="0.6 0.6"/>
    <pair geom1="left_hand_collision" geom2="step5" condim="3" friction="0.6 0.6"/>
    <pair geom1="left_hand_collision" geom2="landing" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_hand_collision" geom2="step1" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_hand_collision" geom2="step2" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_hand_collision" geom2="step3" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_hand_collision" geom2="step4" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_hand_collision" geom2="step5" condim="3" friction="0.6 0.6"/>
    <pair geom1="right_hand_collision" geom2="landing" condim="3" friction="0.6 0.6"/>
  </contact>

  <include file="sensor.xml"/>

  <keyframe>
    <key name="home"
      qpos="
      0 0 0.785
      1 0 0 0
      -0.1 0 0 0.3 -0.2 0
      -0.1 0 0 0.3 -0.2 0
      0 0 0
      0.2 0.2 0 1.28 0 0 0
      0.2 -0.2 0 1.28 0 0 0
      "
      ctrl="
      -0.1 0 0 0.3 -0.2 0
      -0.1 0 0 0.3 -0.2 0
      0 0 0
      0.2 0.2 0 1.28 0 0 0
      0.2 -0.2 0 1.28 0 0 0
      "/>
    <key name="knees_bent"
      qpos="
      0 0 0.755
      1 0 0 0
      -0.312 0 0 0.669 -0.363 0
      -0.312 0 0 0.669 -0.363 0
      0 0 0.073
      0.2 0.2 0 0.6 0 0 0
      0.2 -0.2 0 0.6 0 0 0
      "
      ctrl="
      -0.312 0 0 0.669 -0.363 0
      -0.312 0 0 0.669 -0.363 0
      0 0 0.073
      0.2 0.2 0 0.6 0 0 0
      0.2 -0.2 0 0.6 0 0 0
    "/>
  </keyframe>
</mujoco>
